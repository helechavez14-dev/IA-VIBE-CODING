from pathlib import Path

html = r'''<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f7eaff">
  <title>Rayitos en Ruta</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <style>
    :root{--pink:#f58ab8;--pink2:#ffe0ef;--blue:#8dbdff;--turq:#83ded7;--lav:#c9b5f5;--ink:#28345f;--muted:#7782a7;--paper:#fff;--line:#e8e7f7}
    *{box-sizing:border-box} body{margin:0;background:linear-gradient(145deg,#f8efff,#eaf7ff 55%,#fff0f6);font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);min-height:100vh}
    .app{width:min(100%,560px);margin:auto;padding:18px 15px 34px}
    header{display:flex;align-items:center;justify-content:space-between;margin:5px 2px 16px}
    h1{font-size:1.45rem;margin:0;letter-spacing:-.04em} .sub{font-size:.82rem;color:var(--muted);margin-top:3px}
    .mascot{font-size:2rem;background:#fff9;border:1px solid white;border-radius:18px;padding:7px 10px}
    .card{background:#ffffffdf;border:1px solid #fff;border-radius:22px;padding:17px;margin:12px 0;box-shadow:0 8px 24px #8d9ac51c}
    label{display:block;font-size:.82rem;font-weight:700;margin:0 0 7px}
    .field{position:relative;margin-bottom:13px}
    input,select{width:100%;border:1px solid var(--line);background:#fff;border-radius:13px;padding:13px 12px;font:inherit;color:var(--ink);outline:none;min-height:48px}
    input:focus,select:focus{border-color:#9f9af1;box-shadow:0 0 0 3px #c9b5f544}
    .suggestions{position:absolute;z-index:1000;top:100%;left:0;right:0;background:white;border:1px solid var(--line);border-radius:12px;box-shadow:0 8px 20px #38416a22;overflow:hidden}
    .suggestions button{display:block;width:100%;text-align:left;background:white;border:0;border-bottom:1px solid #f0eff8;padding:11px 12px;color:var(--ink);font:inherit;font-size:.84rem}
    .suggestions button:active{background:var(--pink2)}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
    .mode{border:1px solid var(--line);background:#fff;border-radius:14px;padding:12px 5px;font:inherit;color:var(--ink);font-size:.83rem}
    .mode span{display:block;font-size:1.35rem;margin-bottom:3px}.mode.active{border:2px solid #a99af0;background:#f4efff}
    .arrival{margin-top:15px}
    .primary{width:100%;border:0;border-radius:16px;padding:15px;background:linear-gradient(100deg,#6bcfd7,#9fafff,#f28bbd);color:white;font-weight:800;font-size:1rem;margin-top:12px;box-shadow:0 5px 14px #b2a6e455}
    button{cursor:pointer}.primary:active,.mode:active{transform:scale(.98)}
    .status{border-radius:18px;padding:16px;margin-top:14px;background:linear-gradient(120deg,#d8fbf5,#e5efff);transition:background .3s}
    .status.urgent{background:linear-gradient(120deg,#ffe0ec,#ffd5df)}.status h2{font-size:1.06rem;margin:0 0 6px}.status p{margin:0;font-size:.87rem;line-height:1.45}
    .metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:13px}
    .metric{background:#fff9;border-radius:14px;padding:12px}.metric strong{display:block;font-size:1.35rem}.metric small{color:var(--muted)}
    #map{height:250px;border-radius:16px;margin-top:13px;z-index:1}
    .hint{font-size:.75rem;color:var(--muted);line-height:1.45;margin:10px 2px 0}
    .error{color:#a33b65;font-size:.82rem;margin-top:8px}
    .secondary{background:white;border:1px solid var(--line);border-radius:12px;padding:10px 12px;color:var(--ink);font-weight:650}
    .row{display:flex;justify-content:space-between;align-items:center;gap:10px}
    footer{text-align:center;color:var(--muted);font-size:.72rem;padding:14px}
    @media(min-width:560px){.app{padding-top:28px}.card{padding:20px}#map{height:300px}}
  </style>
</head>
<body>
<main class="app">
  <header>
    <div><h1>🌸 Rayitos en Ruta</h1><div class="sub">Tu tiempo, tu ruta, sin carreras.</div></div>
    <div class="mascot" aria-label="gatito">🐱</div>
  </header>

  <section class="card">
    <div class="field">
      <label for="origin">📍 ¿Desde dónde sales?</label>
      <input id="origin" autocomplete="off" placeholder="Ej. Casa, Cuernavaca">
      <div id="originList" class="suggestions" hidden></div>
    </div>
    <div class="field">
      <label for="destination">🏁 ¿A dónde vas?</label>
      <input id="destination" autocomplete="off" placeholder="Ej. Plaza de Armas, Cuernavaca">
      <div id="destinationList" class="suggestions" hidden></div>
    </div>

    <label>🚦 ¿Cómo vas?</label>
    <div class="grid" role="group" aria-label="Medio de transporte">
      <button class="mode active" data-mode="walk"><span>🚶</span>A pie</button>
      <button class="mode" data-mode="transit"><span>🚌</span>Transporte</button>
      <button class="mode" data-mode="car"><span>🚗</span>Auto</button>
    </div>
    <div class="arrival">
      <label for="arrival">🕒 ¿A qué hora quieres llegar?</label>
      <input id="arrival" type="datetime-local">
    </div>
    <button class="primary" id="calculate">Calcular cuándo salir ✨</button>
    <div id="error" class="error" role="alert"></div>
    <p class="hint">Escribe al menos 3 letras y elige una sugerencia para usar coordenadas reales. Se agregan 5 minutos de margen automáticamente.</p>
  </section>

  <section class="card" id="result" hidden>
    <div class="row"><strong>Tu plan de viaje</strong><button class="secondary" id="refresh">Actualizar</button></div>
    <div id="status" class="status">
      <h2 id="message">Calculando…</h2><p id="detail"></p>
    </div>
    <div class="metrics">
      <div class="metric"><strong id="duration">—</strong><small>Tiempo estimado</small></div>
      <div class="metric"><strong id="distance">—</strong><small>Distancia</small></div>
      <div class="metric"><strong id="leave">—</strong><small>Hora recomendada de salida</small></div>
      <div class="metric"><strong id="arrive">—</strong><small>Llegada estimada si sales ahora</small></div>
    </div>
    <div id="map"></div>
    <p class="hint" id="methodNote"></p>
    <button class="primary" id="mapsLink">Abrir indicaciones en mapas ↗</button>
  </section>
  <footer>Prototipo móvil · Datos de OpenStreetMap · Revisa siempre las condiciones reales del trayecto.</footer>
</main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const $ = id => document.getElementById(id);
const GEOAPIFY_API_KEY = '6d989cfc8cd143d39875c6f7a9aaa1b7';
let selected = {origin:null,destination:null}, mode='walk', map, routeLayer, markers, lastResult=null, timer;
const modeButtons=[...document.querySelectorAll('.mode')];
modeButtons.forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;modeButtons.forEach(x=>x.classList.toggle('active',x===b));}));
function localDateValue(d){const pad=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;}
const defaultArrival=new Date(Date.now()+90*60000); $('arrival').value=localDateValue(defaultArrival);
function debounce(fn,wait){let t;return (...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),wait)}}
async function geocode(q) {
  const url = new URL(
    "https://api.geoapify.com/v1/geocode/autocomplete"
  );

  url.searchParams.set("text", q);
  url.searchParams.set("format", "json");
  url.searchParams.set("lang", "es");
  url.searchParams.set("limit", "5");
  url.searchParams.set("filter", "countrycode:mx");
  url.searchParams.set("apiKey", GEOAPIFY_API_KEY);

  const response = await fetch(url);

  if (!response.ok) {
    throw new Error("No se pudieron buscar las direcciones.");
  }

  const data = await response.json();

  return data.results.map(place => ({
    lat: place.lat,
    lon: place.lon,
    display_name: place.formatted
  }));
}
function attachAutocomplete(inputId,listId,key){
 const input=$(inputId), list=$(listId);
 input.addEventListener('input',debounce(async()=>{
  const q=input.value.trim(); selected[key]=null; list.innerHTML=''; list.hidden=true;
  if(q.length<3)return;
  try{
   const items=await geocode(q); if(!items.length){list.innerHTML='<button type="button">No encontré lugares. Prueba con otra búsqueda.</button>';list.hidden=false;return;}
   items.forEach(place=>{const b=document.createElement('button');b.type='button';b.textContent=place.display_name;b.addEventListener('click',()=>{input.value=place.display_name;selected[key]={lat:+place.lat,lon:+place.lon,name:place.display_name};list.hidden=true;});list.appendChild(b);});
   list.hidden=false;
  }catch(e){$('error').textContent=e.message;}
 },450));
 document.addEventListener('click',e=>{if(!list.contains(e.target)&&e.target!==input)list.hidden=true;});
}
attachAutocomplete('origin','originList','origin');attachAutocomplete('destination','destinationList','destination');
function haversine(a,b){const R=6371,rad=x=>x*Math.PI/180,dLat=rad(b.lat-a.lat),dLon=rad(b.lon-a.lon),x=Math.sin(dLat/2)**2+Math.cos(rad(a.lat))*Math.cos(rad(b.lat))*Math.sin(dLon/2)**2;return 2*R*Math.asin(Math.sqrt(x));}
async function getRoute(a, b) {
  const travelMode = mode === "car" ? "drive" : "walk";

  const url = new URL("https://api.geoapify.com/v1/routing");

  url.searchParams.set(
    "waypoints",
    `${a.lat},${a.lon}|${b.lat},${b.lon}`
  );

  url.searchParams.set("mode", travelMode);
  url.searchParams.set("apiKey", GEOAPIFY_API_KEY);

  const response = await fetch(url);

  if (!response.ok) {
    throw new Error("No se pudo calcular la ruta.");
  }

  const data = await response.json();

  if (!data.features || !data.features.length) {
    throw new Error("No encontramos una ruta disponible.");
  }

  const feature = data.features[0];
  const properties = feature.properties;

  return {
    km: properties.distance / 1000,
    minutes: properties.time / 60,
    coords: feature.geometry.coordinates,
    note: travelMode === "drive"
      ? "Ruta calculada para automóvil con Geoapify."
      : "Ruta peatonal calculada con Geoapify."
  };
}
function fmtTime(d){return d.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'});}
async function calculate(){
 $('error').textContent='';
 if(!selected.origin||!selected.destination){$('error').textContent='Elige el origen y el destino desde las sugerencias.';return;}
 const arrival=new Date($('arrival').value);
 if(!$('arrival').value||Number.isNaN(+arrival)){ $('error').textContent='Indica una hora de llegada válida.';return;}
 if(arrival<=new Date()){ $('error').textContent='La hora de llegada debe estar en el futuro.';return;}
 $('calculate').disabled=true;$('calculate').textContent='Calculando ruta…';
 try{
  const route=await getRoute(selected.origin,selected.destination);
  const travelMs=route.minutes*60000, buffer=5*60000, leave=new Date(+arrival-travelMs-buffer), now=new Date(), arriveNow=new Date(+now+travelMs);
  lastResult={route,leave,arrival,arriveNow};
  $('result').hidden=false;$('duration').textContent=Math.max(1,Math.round(route.minutes))+' min';$('distance').textContent=route.km.toFixed(1)+' km';$('leave').textContent=fmtTime(leave);$('arrive').textContent=fmtTime(arriveNow);$('methodNote').textContent=route.note;
  updateUrgency();drawMap(route.coords);
  $('mapsLink').onclick=()=>{const travelMode=mode==='walk'?'walking':mode==='transit'?'transit':'driving';window.open(`https://www.google.com/maps/dir/?api=1&origin=${selected.origin.lat},${selected.origin.lon}&destination=${selected.destination.lat},${selected.destination.lon}&travelmode=${travelMode}`,'_blank');};
 }catch(e){$('error').textContent=e.message||'Ocurrió un error al calcular la ruta.';}
 finally{$('calculate').disabled=false;$('calculate').textContent='Calcular cuándo salir ✨';}
}
function updateUrgency(){
 if(!lastResult)return;
 const {leave,arrival,route}=lastResult,now=new Date(),diff=leave-now,mins=Math.ceil(diff/60000),status=$('status');
 status.classList.toggle('urgent',diff<=0);
 let title,detail;
 if(diff>30*60000){title='Tranquila, tienes tiempo de sobra ☕';detail=`Puedes prepararte con calma. Te recomendamos salir a las ${fmtTime(leave)}.`;}
 else if(diff>10*60000){title='Prepárate, falta poco 🎒';detail=`Faltan aproximadamente ${mins} minutos para tu hora de salida.`;}
 else if(diff>0){title='¡Es hora de salir! 🚀';detail=`Sal en los próximos ${mins} minutos para llegar cerca de las ${fmtTime(arrival)}.`;}
 else{title='¡Ya deberías haber salido! 🏃‍♀️💨';detail=`Tu hora recomendada era ${fmtTime(leave)}. Si sales ahora, podrías llegar alrededor de las ${fmtTime(new Date(+now+route.minutes*60000))}.`;}
 $('message').textContent=title;$('detail').textContent=detail;
}
function drawMap(geometry) {
  if (!map) {
    map = L.map("map").setView(
      [selected.origin.lat, selected.origin.lon],
      13
    );

    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        maxZoom: 19,
        attribution: "© OpenStreetMap contributors"
      }
    ).addTo(map);
  }

  if (routeLayer) map.removeLayer(routeLayer);

  if (markers) markers.clearLayers();
  else markers = L.layerGroup().addTo(map);

  routeLayer = L.geoJSON(geometry, {
    style: {
      color: "#8b83ed",
      weight: 5,
      opacity: 0.85
    }
  }).addTo(map);

  L.marker([selected.origin.lat, selected.origin.lon])
    .addTo(markers)
    .bindPopup("Origen");

  L.marker([selected.destination.lat, selected.destination.lon])
    .addTo(markers)
    .bindPopup("Destino");

  map.fitBounds(routeLayer.getBounds(), { padding: [25, 25] });
  setTimeout(() => map.invalidateSize(), 100);
}
$('calculate').addEventListener('click',calculate);$('refresh').addEventListener('click',calculate);
timer=setInterval(updateUrgency,15000);
document.addEventListener('visibilitychange',()=>{if(!document.hidden)updateUrgency();
drawMap({ type: "LineString", coordinates: route.coords });});
</script>
</body>
</html>'''
path = Path("/mnt/data/rayitos_en_ruta.html")
path.write_text(html, encoding="utf-8")
print(path, path.stat().st_size)

